  KEYWORDS   = "Dynamic pricing, Managerial decision-making, Marketing strategy, Personalized pricing, Programmatic pricing, Regulatory concerns",
  MONTH      = may,
  SHORTTITLE = "Algorithmic pricing",
  TITLE      = "Algorithmic pricing: {Implications} for marketing strategy and regulation",
