  PAGES      = "7267",
  PUBLISHER  = "Multidisciplinary Digital Publishing Institute",
  SHORTTITLE = "The {Impact} of the {Digital} {Economy} on {CO2} {Emissions}",
  TITLE      = "The {Impact} of the {Digital} {Economy} on {CO2} {Emissions}: {A} {Theoretical} and {Empirical} {Analysis}",
  URL        = "https://www.mdpi.com/2071-1050/13/13/7267",
