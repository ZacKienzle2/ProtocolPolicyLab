  PUBLISHER = "Multidisciplinary Digital Publishing Institute",
  TITLE     = "The {Energy} and {Carbon} {Footprint} of the {Global} {ICT} and {E}\&{M} {Sectors} 2010--2015",
  URL       = "https://www.mdpi.com/2071-1050/10/9/3027",
