  TITLE      = "Using social media to promote academic research: {Identifying} the benefits of twitter for sharing academic work",
  URL        = "https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0229446",
  URLDATE    = "2026-01-02",
  VOLUME     = "15",
  YEAR       = "2020"
