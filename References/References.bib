  SHORTTITLE = "The {Impact} of the {Global} {Digital} {Economy} on {Carbon} {Emissions}",
  TITLE      = "The {Impact} of the {Global} {Digital} {Economy} on {Carbon} {Emissions}: {A} {Review}",
